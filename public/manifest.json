{
  "manifest_version": 3,
  "name": "Red Point Elite — Speed Reader",
  "version": "1.0.0",
  "description": "Read any webpage or PDF 3x faster with RSVP speed reading, bionic text, and smart chunking. No account needed.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "tabs", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Read this page with Red Point Elite",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "pdf.min.mjs", "pdf.worker.min.mjs", "privacy.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
